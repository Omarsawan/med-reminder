rules_version = '2';

// Each phone signs in anonymously. A family ("household") is readable and
// writable only by its members, and a phone can become a member only if it
// created the family or knows its join code.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isMember(hid) {
      return signedIn()
        && exists(/databases/$(database)/documents/households/$(hid)/members/$(request.auth.uid));
    }

    // Join codes map a short code to a family. They can be looked up one at
    // a time by exact code but never listed, so codes can't be enumerated.
    match /joinCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if isMember(request.resource.data.householdId)
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if false;
    }

    match /households/{hid} {
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      allow read: if isMember(hid);
      allow update, delete: if false;

      match /members/{uid} {
        allow read: if isMember(hid);
        // A phone adds only itself: as the family's creator, or with a code
        // that belongs to this family.
        allow create: if signedIn() && uid == request.auth.uid && (
          get(/databases/$(database)/documents/households/$(hid)).data.createdBy == request.auth.uid
          || (request.resource.data.code is string
              && get(/databases/$(database)/documents/joinCodes/$(request.resource.data.code)).data.householdId == hid)
        );
        allow delete: if signedIn() && uid == request.auth.uid;
        allow update: if false;
      }

      // people, medicines, logs, photos
      match /{collection}/{docId} {
        allow read, write: if collection != 'members' && isMember(hid);
      }
    }
  }
}
